.serena/
.worktrees/
.superpowers/
docs/superpowers/
bin/
obj/

# Local agent/tooling instructions (kept on disk, not published)
AGENTS.md
CLAUDE.md
.github/copilot-instructions.md
# Skills a skill runner installs into the working tree, and the lockfile that pins their versions.
# Off the record for the same reason AGENTS.md is: they configure whoever is driving the editor, not
# what this library is. The payload is third-party and restorable from the source the lockfile names,
# so nothing is lost by not tracking either one.
.agents/
skills-lock.json
# Rotation ledger written by the design skill. The durable record of what the site's design is lives
# in the stamp at the top of site/BlazorCodeFirst.Site/wwwroot/css/tokens.css, not here.
.hallmark/

# Build/pack output (dotnet pack -o artifacts/…, PackageContentsTests)
artifacts/
*.nupkg

# OS cruft
.DS_Store

# Local wrangler CLI cache/state (account info, not for commit)
.wrangler/

# CI-only install root for wrangler. site.yml points wrangler-action's workingDirectory here so that
# its `npm i wrangler@4` writes package.json and package-lock.json into an ignored directory. Left at
# the default those two land at the repository root, where the job's final working-tree check reads
# them as uncommitted changes and fails (#282). Nothing outside CI creates this directory.
.wrangler-ci/

# Playwright browser test dependencies and run artifacts (tests/BlazorCodeFirst.WebAppTests/browser)
node_modules/
test-results/

# Accessibility snapshots the Playwright MCP server writes, one timestamped file per browser tool
# call. Nothing in either Playwright suite reads them; they are a transcript of one session's
# browsing, so they accumulate without ever being referenced again.
.playwright-mcp/
