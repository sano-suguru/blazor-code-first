<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>BlazorCodeFirst</PackageId>
    <!-- Version comes from eng/Versions.props, the one place it is written (#228). -->
    <Authors>Sano Suguru</Authors>
    <Copyright>Copyright (c) 2026 Sano Suguru</Copyright>
    <!-- The name says it is for Blazor and that you write it in C#, but not which vocabulary you
         write in. This is where that gap is covered, so it must state the HTML mirror explicitly. -->
    <Description>Blazor components written in C#, not .razor. HTML's own vocabulary as C# expressions, compiled to RenderTreeBuilder at build time.</Description>
    <IsPackable>true</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- An SPDX expression rather than PackageLicenseFile: it needs no file in the payload, and
         nuget.org renders it as a link to the license text instead of embedding a copy. The full text
         is at the repository root in LICENSE (#226). -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://blazor-code-first-site.snsgr.workers.dev</PackageProjectUrl>
    <PackageTags>blazor;razor;source-generator;html;dsl;aot;trimming;components</PackageTags>
    <RepositoryUrl>https://github.com/sano-suguru/blazor-code-first</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink is built into the .NET SDK and needs no package reference, but it does need these
         two: PublishRepositoryUrl writes the resolved commit into the package, and
         EmbedUntrackedSources covers generated files that are not in git (#227). The third thing it
         needs, ContinuousIntegrationBuild, is already set for CI in the root Directory.Build.props. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- A separate symbol package, so a consumer can step into the runtime. snupkg keeps the .pdb out
         of the .nupkg entirely, which is why eng/verify-package.sh's exact payload match still holds. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackCompilerAnalyzer;PackScopedCssBuildTask</TargetsForTfmSpecificContentInPackage>
    <CompilerPackStagingDirectory>$(MSBuildThisFileDirectory)obj/compiler-pack/analyzers/dotnet/cs</CompilerPackStagingDirectory>
    <CompilerPackAssemblyPath>$(CompilerPackStagingDirectory)/BlazorCodeFirst.Compiler.dll</CompilerPackAssemblyPath>
    <ScopedCssBuildTaskProject>$(MSBuildThisFileDirectory)../BlazorCodeFirst.Build/BlazorCodeFirst.Build.csproj</ScopedCssBuildTaskProject>
    <!-- NU5100 flags any assembly outside lib/ as "won't be referenced when installed", which is
         true and intentional here: BlazorCodeFirst.Build.dll is a build-time-only MSBuild task,
         never meant to be referenced by a consumer's compilation. It ships under tasks/{tfm}/, a
         sibling of build/,
         matching the relative path BlazorCodeFirst.targets's own UsingTask entries already resolve
         (established and tested in Task 4/5's local dev-time staging under
         src/BlazorCodeFirst.Build/tasks/{tfm}/). -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Granular package reference instead of <FrameworkReference Include="Microsoft.AspNetCore.App" />:
         the shared-framework reference has no browser-wasm runtime pack, so it broke Blazor
         WebAssembly consumers of the packaged library with NETSDK1082 (issue #23). Runtime only
         uses ComponentBase, RenderTreeBuilder, EventCallback, and IComponent, all of which live in
         Microsoft.AspNetCore.Components, so that single package is sufficient. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decorations.cs splices this in via <include>, which the compiler reads straight off disk
         (#416). CoreCompile's incremental check only watches @(Compile) and its declared inputs, so
         without this, editing the fragment file alone leaves the emitted XML doc stale. -->
    <CustomAdditionalCompileInputs Include="Decorations.doc.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BlazorCodeFirst.Compiler/BlazorCodeFirst.Compiler.csproj"
                      BuildReference="false"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackCompilerAnalyzer">
    <MSBuild Projects="../BlazorCodeFirst.Compiler/BlazorCodeFirst.Compiler.csproj"
             Targets="Rebuild"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0;NoBuild=false" />
    <MakeDir Directories="$(CompilerPackStagingDirectory)" />
    <Copy SourceFiles="../BlazorCodeFirst.Compiler/bin/$(Configuration)/netstandard2.0/BlazorCodeFirst.Compiler.dll"
          DestinationFiles="$(CompilerPackAssemblyPath)" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(CompilerPackAssemblyPath)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="PackScopedCssBuildTask">
    <MSBuild Projects="$(ScopedCssBuildTaskProject)"
             Targets="Rebuild"
             Properties="Configuration=$(Configuration);TargetFramework=net472" />
    <MSBuild Projects="$(ScopedCssBuildTaskProject)"
             Targets="Rebuild"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0" />

    <ItemGroup>
      <_ScopedCssBuildTaskNet472File Include="../BlazorCodeFirst.Build/bin/$(Configuration)/net472/BlazorCodeFirst.Build.dll" />
      <_ScopedCssBuildTaskNet10File Include="../BlazorCodeFirst.Build/bin/$(Configuration)/net10.0/BlazorCodeFirst.Build.dll" />
      <_ScopedCssBuildPropsFile Include="../BlazorCodeFirst.Build/build/BlazorCodeFirst.props" />
      <_ScopedCssBuildTargetsFile Include="../BlazorCodeFirst.Build/build/BlazorCodeFirst.targets" />

      <!-- Sibling of build/, not nested under it: BlazorCodeFirst.targets resolves its UsingTask
           entries as "$(MSBuildThisFileDirectory)../tasks/{tfm}/...", i.e. one level up from build/. -->
      <TfmSpecificPackageFile Include="@(_ScopedCssBuildTaskNet472File)">
        <PackagePath>tasks/net472/BlazorCodeFirst.Build.dll</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="@(_ScopedCssBuildTaskNet10File)">
        <PackagePath>tasks/net10.0/BlazorCodeFirst.Build.dll</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="@(_ScopedCssBuildPropsFile)">
        <PackagePath>build/BlazorCodeFirst.props</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="@(_ScopedCssBuildTargetsFile)">
        <PackagePath>build/BlazorCodeFirst.targets</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
