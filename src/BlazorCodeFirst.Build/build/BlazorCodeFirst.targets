<Project>

  <!-- No shared "$(IntermediateOutputPath)bcf-scopedcss\" property is precomputed at the top of
       this file: it is imported from the project body, before the SDK's own implicit Sdk.targets
       import, which is what gives $(IntermediateOutputPath) its final, TFM-suffixed value. A
       PropertyGroup here would evaluate too early and capture an empty or stale
       $(IntermediateOutputPath). $(IntermediateOutputPath) is expanded directly wherever it is
       needed below instead, which is safe: Inputs/Outputs and target-body evaluation both happen at
       build-execution time, after the whole project (including Sdk.targets) has already been
       evaluated. -->

  <!-- dotnet watch discovers what to watch through its own DotNetWatch.targets, imported only by
       the watch process itself, never by a plain build. That file's _CollectWatchItems target reads
       $(CustomCollectWatchItems) (a semicolon list of target names, populated in
       BlazorCodeFirst.props) as one of its DependsOnTargets, the same extension point the Razor SDK
       uses for .razor.css/.cshtml.css (_RazorSdkCustomCollectWatchItems in
       Sdk.Razor.CurrentVersion.targets). Without this, .cs.css sits outside dotnet watch's file set
       entirely and a change to it triggers no rebuild. -->
  <Target Name="_BcfCustomCollectWatchItems">
    <ItemGroup>
      <Watch Include="%(None.FullPath)"
             Condition="$([System.String]::Copy('%(None.FullPath)').EndsWith('.cs.css')) AND '%(None.Watch)' != 'false'" />
    </ItemGroup>
  </Target>

  <Target Name="BcfFindScopedCssInputs">
    <ItemGroup>
      <_BcfScopedCssInput Include="**/*.cs.css" Exclude="$(BaseIntermediateOutputPath)**;$(BaseOutputPath)**" />
    </ItemGroup>
  </Target>

  <!-- No target-level Condition here (or on the two targets below): a Condition on a Target gates
       its DependsOnTargets too, not just its own body, so MSBuild does not run a target's
       dependencies at all when the target's own Condition is false. Since BcfFindScopedCssInputs is
       the thing that would populate the item this target's Condition would test, gating on it here
       would skip the very target that produces it. The task itself already no-ops correctly on an
       empty ScopedCssInputs, so no Condition is needed at all. -->
  <Target Name="BcfComputeScopedCssScope"
          DependsOnTargets="BcfFindScopedCssInputs">
    <ComputeScopedCssScopeTask
        ScopedCssInputs="@(_BcfScopedCssInput)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        AssemblyName="$(AssemblyName)">
      <Output TaskParameter="ScopedCssWithScope" ItemName="_BcfScopedCssWithScope" />
    </ComputeScopedCssScopeTask>
  </Target>

  <!-- BeforeTargets names GenerateMSBuildEditorConfigFileCore explicitly, not just CoreCompile or the
       empty GenerateMSBuildEditorConfigFile wrapper: that wrapper target
       (Microsoft.Managed.Core.targets) has itself no body, only
       DependsOnTargets="...;GenerateMSBuildEditorConfigFileCore", and it is Core that does the actual
       work, reading CompilerVisibleItemMetadata (declared in BlazorCodeFirst.props) and each
       matching item's metadata to write the per-file editorconfig section the generator reads
       CssScope back from. A DependsOnTargets chain always finishes before a BeforeTargets insertion
       point for the same named target runs, so naming the wrapper here (as an earlier version of this
       target did) let Core already run, and write the file with no CssScope section at all, before
       this target's stamp ever landed on @(AdditionalFiles) (measured directly with -v:diag target
       ordering: GenerateMSBuildEditorConfigFileCore executed before BcfStampCssScopeOnAdditionalFiles
       even started). The build still succeeded either way, silently: no exception, just a scope
       attribute that never reached the generated component. Naming Core itself is what actually forces
       this target to run first. -->
  <Target Name="BcfStampCssScopeOnAdditionalFiles"
          DependsOnTargets="BcfComputeScopedCssScope"
          BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile">
    <ItemGroup>
      <AdditionalFiles Include="@(_BcfScopedCssWithScope)" />
    </ItemGroup>
  </Target>

  <Target Name="BcfRewriteScopedCss"
          DependsOnTargets="BcfComputeScopedCssScope"
          Inputs="@(_BcfScopedCssWithScope)"
          Outputs="@(_BcfScopedCssWithScope -> '$(IntermediateOutputPath)bcf-scopedcss\%(FileName)%(Extension).rz.scp.css')">
    <ItemGroup>
      <_BcfScopedCssToRewrite Include="@(_BcfScopedCssWithScope)">
        <OutputFile>$(IntermediateOutputPath)bcf-scopedcss\%(FileName)%(Extension).rz.scp.css</OutputFile>
      </_BcfScopedCssToRewrite>
    </ItemGroup>

    <RewriteScopedCssTask FilesToRewrite="@(_BcfScopedCssToRewrite)" />

    <ItemGroup>
      <_BcfScopedCssRewritten Include="@(_BcfScopedCssToRewrite -> '%(OutputFile)')">
        <OriginalItemSpec>%(_BcfScopedCssToRewrite.Identity)</OriginalItemSpec>
        <CssScope>%(_BcfScopedCssToRewrite.CssScope)</CssScope>
      </_BcfScopedCssRewritten>
    </ItemGroup>
    <ItemGroup>
      <FileWrites Include="@(_BcfScopedCssRewritten)" />
    </ItemGroup>
  </Target>

  <!-- No target-level Condition here, for the same reason Task 4's targets have none: it would gate
       DependsOnTargets too and skip BcfRewriteScopedCss, which is what populates the item this
       target would otherwise test.

       ResolveStaticWebAssetsConfiguration is listed explicitly (matching the SDK's own analogous
       _ComputeScopedCssStaticWebAssets target) rather than left to BeforeTargets="_CollectAllScopedCssAssets"
       to pull in transitively: BeforeTargets only injects this target into a build that is already
       going to reach _CollectAllScopedCssAssets by some other path, it does not itself pull in
       _CollectAllScopedCssAssets's own prerequisites. A build that reaches this target through
       BcfDiscoverScopedCss alone (as -t:BcfDiscoverScopedCss does) would otherwise call
       DefineStaticWebAssets before $(StaticWebAssetBasePath) has ever been computed. -->
  <Target Name="BcfRegisterScopedCssStaticWebAssets"
          DependsOnTargets="BcfRewriteScopedCss;ResolveStaticWebAssetsConfiguration"
          BeforeTargets="_CollectAllScopedCssAssets">
    <ItemGroup>
      <_BcfScopedCssStaticWebAssetCandidate Include="@(_BcfScopedCssRewritten)">
        <RelativePath>%(FileName)%(Extension)</RelativePath>
        <OriginalItemSpec>%(OriginalItemSpec)</OriginalItemSpec>
      </_BcfScopedCssStaticWebAssetCandidate>
    </ItemGroup>

    <DefineStaticWebAssets
        CandidateAssets="@(_BcfScopedCssStaticWebAssetCandidate)"
        SourceType="Computed"
        SourceId="$(PackageId)"
        ContentRoot="$(IntermediateOutputPath)bcf-scopedcss\"
        BasePath="$(StaticWebAssetBasePath)"
        AssetKind="All"
        AssetMode="All"
        AssetRole="Primary"
        AssetMergeSource="$(StaticWebAssetMergeTarget)"
        AssetTraitName="ScopedCss"
        AssetTraitValue="ScopedCssFile"
        CopyToOutputDirectory="Never"
        CopyToPublishDirectory="PreserveNewest">
      <Output TaskParameter="Assets" ItemName="_ScopedCssStaticWebAsset" />
    </DefineStaticWebAssets>
  </Target>

  <Target Name="BcfDiscoverScopedCss"
          DependsOnTargets="BcfStampCssScopeOnAdditionalFiles;BcfRegisterScopedCssStaticWebAssets" />

  <!-- The SDK's own BundleScopedCssFiles only writes "$(PackageId).styles.css" when the project has
       at least one Razor-native scoped css file (@(_ScopedCss), from ComputeCssScope on
       @(RazorComponent)) or an incoming project bundle (@(_ScopedCssProjectBundles)). Neither item
       carries our .cs.css contribution: BCF injects straight into @(_ScopedCssStaticWebAsset), which
       only ever reaches @(_DiscoveredScopedCssFiles), read here as
       @(_CurrentProjectDiscoveredScopedCssFiles), already populated by BundleScopedCssFiles by the
       time this target runs. A project built entirely of .cs components therefore has both those
       gating items empty and BundleScopedCssFiles's ConcatenateCssFiles call skips writing the
       bundle file outright, while ResolveBundledCssAssets (which runs after this target, gated on
       the broader @(_AllScopedCss) that DOES include our contribution) still tries to register a
       StaticWebAsset pointing at that now-missing file and throws. This target fills that specific
       gap: same task, same output path and base path the SDK's own call would have used, run only
       when the SDK's own call was going to skip it. $(_BcfShouldSelfBundle) is computed once, in a
       PropertyGroup at the top of this target's own body, rather than hoisted onto the Target's
       Condition attribute, for the same DependsOnTargets-skip reason as BcfComputeScopedCssScope above.
       AfterTargets doesn't have that failure mode the way a target Condition does, but the pattern is
       kept consistent; a target-body PropertyGroup runs in execution order, after the items it reads
       are already populated by BundleScopedCssFiles, so it is safe here. -->
  <Target Name="BcfBundleScopedCss"
          AfterTargets="BundleScopedCssFiles">
    <PropertyGroup>
      <_BcfShouldSelfBundle>false</_BcfShouldSelfBundle>
      <_BcfShouldSelfBundle Condition="'@(_ScopedCssProjectBundles)' == '' and '@(_ScopedCss)' == '' and '@(_BcfScopedCssRewritten)' != ''">true</_BcfShouldSelfBundle>
    </PropertyGroup>
    <ConcatenateCssFiles
        Condition="'$(_BcfShouldSelfBundle)' == 'true'"
        ScopedCssFiles="@(_CurrentProjectDiscoveredScopedCssFiles)"
        ProjectBundles=""
        ScopedCssBundleBasePath="$(_ScopedCssBundleBasePath)"
        OutputFile="$(_ScopedCssOutputPath)" />
    <ItemGroup Condition="'$(_BcfShouldSelfBundle)' == 'true'">
      <FileWrites Include="$(_ScopedCssOutputPath)" />
    </ItemGroup>
  </Target>

  <!-- Library->app scoped CSS propagation (issue #312 item 3, design doc
       docs/superpowers/specs/2026-08-19-scoped-css-library-propagation-design.md). The SDK's own
       project-bundle ConcatenateCssFiles call (Microsoft.NET.Sdk.StaticWebAssets.ScopedCss.targets,
       the second ConcatenateCssFiles call inside BundleScopedCssFiles) is gated on
       '@(_ScopedCss) != ""', so it never runs for a pure-.cs.css library (no .razor.css at all).
       This target fills that gap: same task, same output path the SDK's own call would have used,
       run only when the SDK's own call was going to skip it. Mirrors BcfBundleScopedCss above, one
       layer up (project bundle instead of app bundle); see that target's own comment for why
       $(_BcfShouldSelfHandleProjectBundle) is computed in a target-body PropertyGroup rather than a
       Condition attribute. A library that also has .razor.css needs no help here: @(_ScopedCss) is
       then non-empty, the SDK's own call runs, and it already reads
       @(_CurrentProjectDiscoveredScopedCssFiles), which includes BCF's own contribution via the
       existing BcfRegisterScopedCssStaticWebAssets target above. $(_BcfShouldSelfHandleProjectBundle)
       is computed once here, not recomputed in BcfRegisterScopedCssProjectBundle below: this target
       always runs first (ResolveScopedCssAssetsDependsOn lists GenerateScopedCssFiles, whose chain
       includes BundleScopedCssFiles, ahead of ResolveBundledCssAssets), so the property this target
       sets is already available by the time that one reads it. -->
  <Target Name="BcfBundleScopedCssProject"
          AfterTargets="BundleScopedCssFiles">
    <PropertyGroup>
      <_BcfShouldSelfHandleProjectBundle>false</_BcfShouldSelfHandleProjectBundle>
      <_BcfShouldSelfHandleProjectBundle Condition="'@(_ScopedCss)' == '' and '@(_BcfScopedCssRewritten)' != ''">true</_BcfShouldSelfHandleProjectBundle>
    </PropertyGroup>
    <ConcatenateCssFiles
        Condition="'$(_BcfShouldSelfHandleProjectBundle)' == 'true'"
        ScopedCssFiles="@(_CurrentProjectDiscoveredScopedCssFiles)"
        ProjectBundles=""
        ScopedCssBundleBasePath="$(_ScopedCssBundleBasePath)"
        OutputFile="$(_ScopedCssProjectOutputPath)" />
    <ItemGroup Condition="'$(_BcfShouldSelfHandleProjectBundle)' == 'true'">
      <FileWrites Include="$(_ScopedCssProjectOutputPath)" />
    </ItemGroup>
  </Target>

  <!-- Registers the ProjectBundle StaticWebAsset the target above just wrote. The SDK's own
       registration (ResolveBundledCssAssets) is ALSO gated on '@(_ScopedCss) != ""'. Without this, a
       pure-.cs.css library never produces an outgoing StaticWebAsset a referencing project's
       GetCurrentProjectStaticWebAssets could pick up. DefineStaticWebAssetEndpoints is required
       alongside DefineStaticWebAssets: registering only the asset made the later
       ApplyCompressionNegotiation task (Microsoft.NET.Sdk.StaticWebAssets.Compression.targets) fail
       the whole build with "Endpoints not found for related asset" (measured against a scratch
       project during the spike for this feature). Reads $(_BcfShouldSelfHandleProjectBundle) rather
       than recomputing it: see BcfBundleScopedCssProject above for why that is safe here. -->
  <Target Name="BcfRegisterScopedCssProjectBundle"
          AfterTargets="ResolveBundledCssAssets">
    <ItemGroup Condition="'$(_BcfShouldSelfHandleProjectBundle)' == 'true'">
      <_BcfScopedCssProjectBundleCandidate Include="$(_ScopedCssProjectOutputPath)">
        <RelativePath Condition="'$(StaticWebAssetFingerprintingEnabled)' == 'true'">$(PackageId)#[.{fingerprint}]!.bundle.scp.css</RelativePath>
        <RelativePath Condition="'$(StaticWebAssetFingerprintingEnabled)' != 'true'">$(PackageId).bundle.scp.css</RelativePath>
      </_BcfScopedCssProjectBundleCandidate>
    </ItemGroup>
    <DefineStaticWebAssets
        Condition="'$(_BcfShouldSelfHandleProjectBundle)' == 'true'"
        CandidateAssets="@(_BcfScopedCssProjectBundleCandidate)"
        SourceType="Computed"
        SourceId="$(PackageId)"
        ContentRoot="$(_ScopedCssProjectBundleContentRoot)"
        BasePath="$(StaticWebAssetBasePath)"
        AssetKind="All"
        AssetMode="Reference"
        AssetRole="Primary"
        RelatedAsset=""
        AssetMergeSource="$(StaticWebAssetMergeTarget)"
        AssetTraitName="ScopedCss"
        AssetTraitValue="ProjectBundle"
        CopyToOutputDirectory="Never"
        CopyToPublishDirectory="PreserveNewest">
      <Output TaskParameter="Assets" ItemName="_BcfScopedCssProjectBundleStaticWebAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints
        Condition="'$(_BcfShouldSelfHandleProjectBundle)' == 'true'"
        CandidateAssets="@(_BcfScopedCssProjectBundleStaticWebAsset)"
        ExistingEndpoints="@(StaticWebAssetEndpoint)"
        ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_BcfScopedCssProjectBundleStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup Condition="'$(_BcfShouldSelfHandleProjectBundle)' == 'true'">
      <StaticWebAsset Include="@(_BcfScopedCssProjectBundleStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_BcfScopedCssProjectBundleStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

  <!-- TFM-branched task assembly directory: VS's own MSBuild is net472, `dotnet build`'s MSBuild is
       net-core. Computed once here rather than repeated per UsingTask, so adding a third task later
       needs one new UsingTask line, not two. -->
  <PropertyGroup>
    <_BcfTaskTfmDirectory>net10.0</_BcfTaskTfmDirectory>
    <_BcfTaskTfmDirectory Condition="'$(MSBuildRuntimeType)' == 'Full'">net472</_BcfTaskTfmDirectory>
    <_BcfTaskAssembly>$(MSBuildThisFileDirectory)../tasks/$(_BcfTaskTfmDirectory)/BlazorCodeFirst.Build.dll</_BcfTaskAssembly>
  </PropertyGroup>
  <UsingTask
      TaskName="BlazorCodeFirst.Build.ComputeScopedCssScopeTask"
      AssemblyFile="$(_BcfTaskAssembly)" />
  <UsingTask
      TaskName="BlazorCodeFirst.Build.RewriteScopedCssTask"
      AssemblyFile="$(_BcfTaskAssembly)" />

</Project>
