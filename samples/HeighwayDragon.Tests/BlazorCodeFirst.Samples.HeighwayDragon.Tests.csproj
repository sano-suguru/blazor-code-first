<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Compiles the generator's source directly rather than a ProjectReference, so this test
       project never restores BlazorCodeFirst as a package and stays a plain net10.0 class-library
       test project. DragonCurveGenerator.cs has no UI or JS dependency, so this is the whole
       surface it needs. -->
  <ItemGroup>
    <Compile Include="../HeighwayDragon/DragonCurveGenerator.cs" />
  </ItemGroup>

</Project>
