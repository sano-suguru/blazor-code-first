<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WasmEnableThreads>true</WasmEnableThreads>
    <!-- [JSImport]/[JSExport] (DragonGlInterop.cs) require this; SYSLIB1074 otherwise. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Isolated so `rm -rf artifacts/samples/packages` resets this restore completely, the same
         reason tests/BlazorCodeFirst.WasmPackageApp isolates its own path. NuGet.config's
         local-blazorcodefirst source lets an unreleased runtime change be tested here via a local
         `dotnet pack`; CI restores the published BlazorCodeFirst from nuget.org instead, the way an
         actual consumer would (#442). -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/samples/packages</RestorePackagesPath>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../eng/BlazorCodeFirstDevCache.props" />

  <ItemGroup>
    <PackageReference Include="BlazorCodeFirst" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

</Project>
