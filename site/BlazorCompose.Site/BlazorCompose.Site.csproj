<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- site/ is outside the solution and carries experimental deps; keep its
         versions local so the shared Directory.Packages.props stays clean. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Compose components navigate without throwing on cancellation (mirrors the sample). -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- M0 spike: Step 1 Release publish produced zero IL2xxx/IL3xxx trim warnings, so lock in
         the clean state and fail fast if a future change introduces one. -->
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <!-- M0b spike: BlazorWasmPreRendering.Build config. Static mode crawls/fetches routes at
         publish time and bakes the compose-generated RenderBody output into each route's
         index.html as plain HTML, before any WASM/JS executes. -->
    <BlazorWasmPrerenderingMode>Static</BlazorWasmPrerenderingMode>
    <BlazorWasmPrerenderingKeepServer>false</BlazorWasmPrerenderingKeepServer>
  </PropertyGroup>

  <ItemGroup>
    <!-- M0b spike: build-time static prerendering (community tool; not a first-class .NET 10
         feature). Version pinned explicitly because the latest STABLE release (8.0.1 at spike
         time) predates net10.0 support; 8.1.0-preview.4 is the first version whose restore
         reports compatibility with a net10.0 TargetFramework. Prerelease dependency accepted as a
         spike caveat; revisit for a stable net10 release (or a self-hosted prerender step). -->
    <PackageReference Include="BlazorWasmPreRendering.Build" Version="8.1.0-preview.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorCompose.Runtime\BlazorCompose.Runtime.csproj" />
    <ProjectReference Include="..\..\src\BlazorCompose.Compiler\BlazorCompose.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Derive the prerendered route list from the same source of truth as the docs manifest
       (site/content/*.md), so adding a document cannot silently skip prerendering.

       This must be a target, not a static PropertyGroup: MSBuild evaluates properties before items,
       so @(DocMarkdown) would be empty at evaluation time. The prerender tool's own target runs
       AfterTargets="Publish" and expands the property inside its Exec command line, i.e. at target
       execution time, so setting it from a BeforeTargets hook is sufficient. If the tool ever renames
       that target this silently stops applying — the CI prerender verification is what catches it. -->
  <Target Name="ComputeDocsPrerenderPaths" BeforeTargets="BlazorWasmPrerendering">
    <ItemGroup>
      <DocMarkdown Include="$(MSBuildProjectDirectory)/../content/*.md" />
    </ItemGroup>
    <PropertyGroup>
      <BlazorWasmPrerenderingUrlPathToExplicitFetch>/;/counter;/docs;@(DocMarkdown->'/docs/%(Filename)')</BlazorWasmPrerenderingUrlPathToExplicitFetch>
    </PropertyGroup>
    <Message Importance="high" Text="Prerendering routes: $(BlazorWasmPrerenderingUrlPathToExplicitFetch)" />
  </Target>

</Project>
