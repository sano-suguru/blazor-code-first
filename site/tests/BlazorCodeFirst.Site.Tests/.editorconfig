# This project lives under site/tests/, outside the repository-root .editorconfig's `tests/**/*.cs`
# exemption glob (which only covers the top-level tests/ directory), so the xUnit-convention CA1707
# exemption is re-applied here for this test project specifically. The same file under
# site/tools/BlazorCodeFirst.Site.DocGen.Tests exists for that reason.
[*.cs]
# xUnit convention: underscore-separated test method names.
dotnet_diagnostic.CA1707.severity = none
