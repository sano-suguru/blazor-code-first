# site/BlazorCodeFirst.Site is an application (Blazor WebAssembly entry point + components), not
# a library. ConfigureAwait(false) is inappropriate here: Blazor's renderer relies on the
# default SynchronizationContext to marshal continuations back to the render thread, so
# suppressing it (as CA2007 suggests) can break component state updates. This mirrors the
# CA2007 exemption already applied to tests/**/*.cs in the repository-root .editorconfig.
[*.cs]
dotnet_diagnostic.CA2007.severity = none

# Page components under Pages/ carry [Route] and must stay public: Blazor's Router
# discovers routable components via Assembly.ExportedTypes(), which only returns public types.
# Making these classes internal (as CA1515 suggests for application-only APIs) would silently
# remove them from the route table instead of producing a build error, so the analyzer
# suggestion is inapplicable here and is suppressed for this directory only.
[Pages/*.cs]
dotnet_diagnostic.CA1515.severity = none

# Layout components are referenced from MainLayout.razor by tag name, and Razor's component
# discovery only resolves public types: making these internal (as CA1515 suggests for
# application-only APIs) fails the build with RZ10012 and additionally trips CA1812. The analyzer
# suggestion is therefore inapplicable to this directory.
[Layout/*.cs]
dotnet_diagnostic.CA1515.severity = none
