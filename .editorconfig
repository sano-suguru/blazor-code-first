root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

# CA1724: the 'Html' type intentionally shares a name with widely used HTML helper types
# elsewhere in .NET, none of which this project targets or references. The short name is a
# deliberate part of the authoring surface (`using static BlazorCodeFirst.Html;`).
dotnet_diagnostic.CA1724.severity = none

# --- Modern C# idioms (enforced) ---
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_prefer_simple_default_expression = true:warning
csharp_style_prefer_index_operator = false:silent
csharp_style_prefer_range_operator = false:silent
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_style_readonly_field = true:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# --- Naming (enforced) ---
# More specific field rules come first; the first applicable rule wins, so const and
# static-readonly fields are matched here before the general private-instance-field rule.
# Constants are PascalCase (never underscore-prefixed).
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

# Private static readonly fields are PascalCase (treated as constants, not instance fields).
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# Private instance fields are _camelCase.
dotnet_naming_rule.private_fields_underscore_camel.severity = warning
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.interfaces_prefixed_i.severity = warning
dotnet_naming_rule.interfaces_prefixed_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

dotnet_naming_rule.types_and_members_pascal.severity = warning
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,enum,property,method,event,namespace
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Test projects: analyzer rules that are inappropriate for test code.
[tests/**/*.cs]
# Assertions match generated ASCII C# source ordinally; globalization-aware string
# APIs add only noise here (all CA1307 occurrences originate in these projects).
# Explicit rule ids are used rather than the Globalization category so they win over
# the per-rule defaults that AnalysisLevel=latest-all sets.
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
# xUnit convention: underscore-separated test method names.
dotnet_diagnostic.CA1707.severity = none
# ConfigureAwait is unnecessary in test code (no synchronization context to capture).
dotnet_diagnostic.CA2007.severity = none
# Test fixtures and sources are legitimately public.
dotnet_diagnostic.CA1515.severity = none
# Test-scoped disposal and sync calls are acceptable in test bodies.
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1849.severity = none
# Test helpers need not validate parameters that tests always supply.
dotnet_diagnostic.CA1062.severity = none

# Diff-cost harness: reads Microsoft.AspNetCore.Components.RenderTree types (RenderBatch,
# RenderTreeDiff, RenderTreeEdit, RenderTreeFrame), which BL0006 flags as not intended for use
# outside the Blazor framework. Reading them IS the measurement: DESIGN.md §7.2 makes claims about
# the frames and edits Blazor's diff actually produces, and no other public API reports those. The
# Microsoft.AspNetCore.Components pin in Directory.Packages.props is what keeps this stable; BL0006
# is Microsoft reserving the right to change these shapes, so a Components bump can break these
# files and that is the expected failure mode, not a surprise.
# Sample apps under samples/: the same CA1515/CA2007 tension tests/BlazorCodeFirst.WasmPackageApp's
# Root.cs documents. The root component must be public because RootComponents.Add<T> is not a
# construction site the CA1812 (uninstantiated internal type) analyzer recognizes, and Program.cs's
# top-level await has no meaningful synchronization context to preserve with ConfigureAwait.
# The pattern is `**.cs`, not `**/*.cs`, for the reason the Benchmarks section below states: the
# latter does not match files sitting directly in the project directory, which is where
# Program.cs/DragonCurveView.cs live.
[samples/HeighwayDragon/**.cs]
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none

# Sample test projects: the same leniency as [tests/**/*.cs], for the same reasons -- these live
# under samples/ rather than tests/ because they compile the sample's own source file directly
# (see the .csproj comment) rather than referencing a library project.
[samples/HeighwayDragon.Tests/**.cs]
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.CA1062.severity = none

[tests/BlazorCodeFirst.IntegrationTests/DiffCost/*.cs]
dotnet_diagnostic.BL0006.severity = none

# Allocation benchmarks: same RenderTree access as above. BenchmarkDotNet additionally requires
# public instance [Benchmark] methods on a public class it instantiates by reflection, which CA1822
# (mark as static) and CA1812 (uninstantiated internal class) both misread. CA1001 wants the
# benchmark class to be IDisposable for the renderers it holds, but BenchmarkDotNet never disposes a
# benchmark instance; [GlobalCleanup] is its teardown hook and that is where they are released.
# The pattern is `**.cs`, not `**/*.cs`: the latter does not match files sitting directly in the
# project directory, which is where the renderer and the benchmarks themselves live.
[tests/BlazorCodeFirst.Benchmarks/**.cs]
dotnet_diagnostic.BL0006.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1001.severity = none

# Prerender tests: same RenderTree access as above, for the same reason. Whether FoldEscapingPage's
# #140 fold produced exactly one frame is itself the premise the escaping test next to it depends on,
# and RenderTreeBuilder.GetFrames() is the only way to observe that count; no public API reports it.
# NonStringValueFormattingTests is here on a second reason: the premise it pins belongs to a document
# rather than to a browser spec. That a frame already holds a formatted string is what DESIGN.md §4.1
# and ARCHITECTURE.md §2.7(D) rest on when they refuse non-string values (#158, #245), and the frame's
# TextContent / AttributeValue are the only way to see it. AttributeSplatMeasurementTests is here on
# that same second reason: 付録B.14 refuses a runtime attribute name and an attribute splat over what
# the builder does with the frames they would produce, and the sequence numbers and the surviving
# duplicates are visible nowhere else.
[tests/BlazorCodeFirst.WebAppTests/*.cs]
dotnet_diagnostic.BL0006.severity = none

# Production code: banned-API usage (reflection / runtime expression compilation) is a
# hard error, guarding the trimming/AOT-safe contract.
[src/**/*.cs]
dotnet_diagnostic.RS0030.severity = error
