<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analyzer delivered exactly as this repository's own consumer projects deliver it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BlazorCodeFirst.Runtime\BlazorCodeFirst.Runtime.csproj" />
    <ProjectReference Include="..\..\..\src\BlazorCodeFirst.Compiler\BlazorCodeFirst.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- BCF3038 has no arm that works without this assembly: every one of them reads the [EventHandler]
         registrations, which KnownSymbols gates on Microsoft.AspNetCore.Components.Web being resolvable.
         So the shape cannot be delivered from a project that does not reference it (#369).

         Referencing it here rather than adding a fifth fixture project, because a real consumer has it:
         BlazorCodeFirst.WebAppTestHost builds on Microsoft.NET.Sdk.Web and the WasmPackageApp gets it
         through Components.WebAssembly, so this is a step toward what this fixture claims to be and not
         away from it. The cost is that a real build no longer covers the branch where the table is absent
         and the check is skipped in silence; EventModifierSupportDiagnosticTests and
         EventArgumentTypeDiagnosticTests cover that in-process, through
         CompilationTestHost.CreateCompilationWithoutComponentsWeb. The alternative that would have avoided
         this reference is recorded where its own reader is, on KnownSymbols' mappingAvailable gate. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
