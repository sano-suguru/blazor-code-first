<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analyzer delivered exactly as this repository's own consumer projects deliver it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BlazorCodeFirst.Runtime\BlazorCodeFirst.Runtime.csproj" />
    <ProjectReference Include="..\..\..\src\BlazorCodeFirst.Compiler\BlazorCodeFirst.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bcf3038.cs asks about oncancel, one of the two framework registrations that disable
         stopPropagation, and those ship here. Since #396 a registration the compilation declares itself is
         read without this assembly, so a fixture spelling BCF3038 that way would not need it; oncancel is
         kept because it is the shape an author actually meets, and the custom-registration path is pinned
         in-process by EventModifierSupportDiagnosticTests.

         Referencing it here rather than adding a fifth fixture project, because a real consumer has it:
         BlazorCodeFirst.WebAppTestHost builds on Microsoft.NET.Sdk.Web and the WasmPackageApp gets it
         through Components.WebAssembly, so this is a step toward what this fixture claims to be and not
         away from it. The cost is that a real build no longer covers the branch where the framework table
         is absent; EventModifierSupportDiagnosticTests and EventArgumentTypeDiagnosticTests cover that
         in-process, through CompilationTestHost.CreateCompilationWithoutComponentsWeb (#369). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
