<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Same feed ScopedCss.Package uses: both pack BlazorCodeFirst.Runtime.csproj, and packing it
         once for both fixtures avoids rebuilding its compiler and build-task DLLs from source twice
         (see ScopedCssFixtures.cs's shared _runtimePackageFeed). -->
    <add key="local-scoped-css" value="../../../artifacts/diagnostic-tests/scoped-css/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
