<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../../artifacts/diagnostic-tests/razor-interop/packages</RestorePackagesPath>
    <_BlazorCodeFirstCache>$(RestorePackagesPath)/blazorcodefirst/0.1.0-dev</_BlazorCodeFirstCache>
    <_RazorFixtureCache>$(RestorePackagesPath)/blazorcodefirst.razorinteropfixture/0.1.0-dev</_RazorFixtureCache>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="BlazorCodeFirst" />
    <PackageReference Include="BlazorCodeFirst.RazorInteropFixture" VersionOverride="0.1.0-dev" />
  </ItemGroup>
  <Target Name="PurgeInteropDevCaches" BeforeTargets="Restore" Condition="'$(MSBuildRestoreSessionId)' != ''">
    <Message Importance="high" Text="Purging stale dev cache: $(_BlazorCodeFirstCache)" Condition="Exists('$(_BlazorCodeFirstCache)')" />
    <Message Importance="high" Text="Purging stale dev cache: $(_RazorFixtureCache)" Condition="Exists('$(_RazorFixtureCache)')" />
    <RemoveDir Directories="$(_BlazorCodeFirstCache)" Condition="Exists('$(_BlazorCodeFirstCache)')" />
    <RemoveDir Directories="$(_RazorFixtureCache)" Condition="Exists('$(_RazorFixtureCache)')" />
  </Target>
</Project>
