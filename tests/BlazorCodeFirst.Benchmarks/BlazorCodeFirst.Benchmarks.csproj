<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorCodeFirst.Runtime\BlazorCodeFirst.Runtime.csproj" />
    <ProjectReference Include="..\..\src\BlazorCodeFirst.Compiler\BlazorCodeFirst.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frame-equivalence gate is what makes both the §7.1 and §7.2 numbers attributable, and a
         second copy could drift so that one measurement silently weakens. Linked rather than copied
         for that reason; a shared project for one file would be heavier. Its physical path keeps the
         .editorconfig BL0006 allowance that the DiffCost directory carries. -->
    <Compile Include="..\BlazorCodeFirst.IntegrationTests\DiffCost\FrameEquivalence.cs"
             Link="FrameEquivalence.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The #140 fold fixtures. Their DOM-equivalence gate needs bunit, which lives in the test
         project, and the benchmark needs the same components; linked rather than copied for the same
         reason FrameEquivalence.cs is, and in the same direction. This project has no
         ProjectReference to IntegrationTests, so the generator runs over these files again here and
         each assembly gets its own partial. -->
    <Compile Include="..\BlazorCodeFirst.IntegrationTests\Components\StaticHeavyElementView.cs"
             Link="Components\StaticHeavyElementView.cs" />
    <Compile Include="..\BlazorCodeFirst.IntegrationTests\Components\StaticHeavyMarkupView.cs"
             Link="Components\StaticHeavyMarkupView.cs" />
    <Compile Include="..\BlazorCodeFirst.IntegrationTests\Components\MixedElementView.cs"
             Link="Components\MixedElementView.cs" />
    <Compile Include="..\BlazorCodeFirst.IntegrationTests\Components\MixedMarkupView.cs"
             Link="Components\MixedMarkupView.cs" />
  </ItemGroup>
</Project>
