<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The [EventHandler] table BCF3028 reads lives here, and a test compilation only has it if this
         project does: CompilationTestHost builds its references from this process's assemblies. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Snapshots/ holds committed baselines of generated source (see GeneratedSourceSnapshot). They are C#
    by extension so a reviewer reads them with highlighting, but they must not be compiled: each declares
    the same partial type as the test input that produced it, so the SDK's default glob would pull in
    duplicate definitions. Keeping them out of Compile also keeps them out of `dotnet format`'s document
    set, which is required — the emitter writes no final newline while .editorconfig asks for one.
    Removing this exclusion produces duplicate-definition errors whose cause is not obvious from them.
  -->
  <ItemGroup>
    <Compile Remove="Snapshots\**" />
    <None Include="Snapshots\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorCodeFirst.Compiler\BlazorCodeFirst.Compiler.csproj" />
    <ProjectReference Include="..\..\src\BlazorCodeFirst.Runtime\BlazorCodeFirst.Runtime.csproj" />
  </ItemGroup>
</Project>
